# 서버 설정
PORT=3000
HOST=0.0.0.0

# 카카오 챗봇 설정
KAKAO_BOT_ID=your_bot_id
KAKAO_SKILL_SECRET=your_skill_secret

# Clawdbot 설정
CLAWDBOT_MODE=gateway
CLAWDBOT_GATEWAY_URL=http://localhost:18789
CLAWDBOT_GATEWAY_TOKEN=your_gateway_token
CLAWDBOT_MODEL=
CLAWDBOT_SYSTEM_PROMPT=당신은 카카오톡을 통해 대화하는 AI 어시스턴트입니다.

# ===== Slack 봇 설정 =====
# Slack App 생성: https://api.slack.com/apps
#
# [Socket Mode - 권장, 공개 URL 불필요]
# 1. Slack App 설정 → Socket Mode 활성화
# 2. App-Level Tokens → connections:write 권한으로 토큰 생성 (xapp-...)
# 3. OAuth & Permissions → Bot Token Scopes 추가:
#    chat:write, im:history, im:read, im:write,
#    app_mentions:read, channels:history, reactions:write
# 4. Event Subscriptions → Subscribe to Bot Events:
#    message.im, app_mention
# 5. 워크스페이스에 앱 설치 후 Bot User OAuth Token 복사 (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# [HTTP Mode - Socket Mode 미사용 시]
# SLACK_SIGNING_SECRET=your-signing-secret
# SLACK_PORT=3001

# 보안 설정
PAIRING_CODE=your_secret_pairing_code
ADMIN_KAKAO_ID=

# 로깅
LOG_LEVEL=info
